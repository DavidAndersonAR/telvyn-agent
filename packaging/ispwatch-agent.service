[Unit]
Description=IspWatch Agent
Documentation=https://docs.ispwatch.com/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ispwatch
Group=ispwatch
# Config vem do EnvironmentFile (modelo certless/Bearer: ISPWATCH_INGEST_URL +
# ISPWATCH_INGEST_TOKEN + ISPWATCH_AGENT_KIND + toggles). O '-' torna a ausência
# não-fatal. O binário não tem flag --config; toda config é por env var.
EnvironmentFile=-/etc/ispwatch/agent.env
ExecStart=/usr/local/bin/ispwatch-agent
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=5

# === Hardening obrigatório ============================================
# CAP_NET_RAW libera ICMP ping sem privilegio root (Plan 03-03 depende).
# CAP_NET_BIND_SERVICE permite bind em portas < 1024 caso algum check
# precise (margem futura — checks atuais não bindam portas baixas).
# Descoberta de serviços (host/services): pra mapear socket→pid e medir CPU/mem
# o agente lê /proc/<pid>/fd + /proc/<pid>/stat de processos ALHEIOS. Isso exige
# DUAS caps (senão só enxerga a si mesmo):
#   · CAP_SYS_PTRACE     — passa no ptrace_may_access (PTRACE_MODE_READ).
#   · CAP_DAC_READ_SEARCH — fura a permissão DAC do /proc/<pid>/fd (modo 0500
#                           dono do processo). Sem ela o open do dir dá EACCES.
# Read-only de /proc — não chamamos ptrace() (bloqueado por @debug abaixo).
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Pitfall 7: precisa listar EXATAMENTE os dirs que o agente escreve,
# senão WAL trava com EROFS. /etc/ispwatch fica read-only via strict.
ReadWritePaths=/var/lib/ispwatch /var/log/ispwatch

# === Hardening adicional (RESEARCH §Security Domain) ==================
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# default (sem hidepid): a descoberta de serviços precisa LISTAR e LER os outros
# processos em /proc pra mapear socket→pid e medir CPU/mem. Com hidepid (invisible
# /ptraceable) o readdir de /proc some com eles; CAP_SYS_PTRACE (acima) garante a
# leitura do /proc/<pid>/fd alheio. O agente segue NÃO-root.
ProtectProc=default
# ProcSubset fica no DEFAULT (all): 'pid' esconde /proc/net (sockets que
# escutam, lidos pela descoberta) e /proc/stat + /proc/meminfo (lidos pelo
# linux.system). Um agente de observabilidade de host precisa desses arquivos.
# Assumption A9: AF_NETLINK é obrigatório porque gopsutil + checks de
# socket usam netlink pra ler stats do kernel. Sem ele alguns checks
# falham com erro críptico EAFNOSUPPORT.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Go runtime não faz JIT — seguro proibir páginas W+X.
MemoryDenyWriteExecute=true
# Permite syscalls de serviço comuns e remove subsets perigosos.
# Equilíbrio segurança vs compatibilidade (Pitfall 4).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @raw-io @reboot @swap @clock @module
SystemCallArchitectures=native
KeyringMode=private
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ispwatch-agent

[Install]
WantedBy=multi-user.target
